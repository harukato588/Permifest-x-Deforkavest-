# ============================================================================
# Permifest x Deforkafest - Environment Variables Template
# Copy file ini menjadi .env.local untuk environment lokal
# ============================================================================

# Supabase Public Configuration (bisa diakses di browser/client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Server-Only Configuration (HANYA di server / Server Actions / Admin)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Demo accounts are only provisioned against local Supabase (127.0.0.1:54321).
# Put credentials in .env.local, never in source control or NEXT_PUBLIC variables.
DEMO_PANITIA_EMAIL=
DEMO_PANITIA_PASSWORD=
DEMO_JURI_EMAIL=
DEMO_JURI_PASSWORD=
DEMO_SUPER_ADMIN_EMAIL=
DEMO_SUPER_ADMIN_PASSWORD=

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
